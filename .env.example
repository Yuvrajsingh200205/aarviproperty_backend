PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/aarvi_property
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma separated list of allowed browser origins (Next.js site)
CLIENT_URL=http://localhost:3000
# Public URL of this API (used to build absolute upload URLs, optional)
PUBLIC_API_URL=http://localhost:5001
# First admin created by `npm run seed`
ADMIN_EMAIL=admin@aarviproperty.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Aarvi Admin
# Optional: email notification for new enquiries
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Max login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=20
# Max enquiry form submissions per IP per 10 minutes
ENQUIRY_RATE_LIMIT=15
